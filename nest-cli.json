{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "tsc",
    "assets": [
      {
        "include": "modules/not-found/template/*",
        "outDir": "dist"
      },
      {
        "include": "assets/fonts/**/*",
        "outDir": "dist"
      }
    ]
  }
}
