{
  "name": "hetarchief-proxy",
  "version": "4.4.5",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "contributors": [
    "Bert Verhelst <bert.verhelst@studiohyperdrive.be>",
    "Femke Reunes <femke.reunes@studiohyperdrive.be>",
    "Ian Emsens <ian.emsens@studiohypderive.be>",
    "Bart Naessens <bart.naessens@studiohyperdrive.be>",
    "Andry Charlier <andry.charlier@studiohyperdrive.be>"
  ],
  "scripts": {
    "prepare": "lefthook install || echo \"lefthook install skipped, see message above\"",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "__predev": "npm run generate-database-types",
    "prestart:debug": "npm run generate-database-types",
    "dev": "dotenv -e .env/.env.local -- nest start --watch",
    "dev-debug": "dotenv -e .env/.env.local nest start --builder tsc",
    "dev-fast": "node --env-file=.env/.env.local ./node_modules/@nestjs/cli/bin/nest.js start",
    "start:debug": "dotenv -e .env/.env.local nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome lint",
    "lint:fix": "biome lint --write --unsafe",
    "format": "biome format --write",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=1 --no-color",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest run --inspect --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest-e2e.config.ts",
    "generate-database-types": "dotenv -e ./.env/.env.local graphql-codegen -- --config codegen-hetarchief.yml",
    "bump": "bump-package-versions --part=patch --strategy=highest ./package.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@meemoo/admin-core-api": "7.0.5",
    "@nestjs/cache-manager": "12.0.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@viaa/avo2-types": "5.0.25",
    "archiver": "7.0.1",
    "async": "^3.2.6",
    "blend-promise-utils": "1.28.0",
    "cache-manager": "7.2.9",
    "cacheable": "2.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "connect-redis": "10.0.0",
    "date-fns": "2.30.0",
    "date-fns-tz": "1.3.8",
    "express-session": "1.19.0",
    "flat": "5.0.2",
    "fs-extra": "10.0.0",
    "got": "11.8.6",
    "helmet": "5.0.2",
    "isbot": "^5.1.25",
    "joi": "18.2.9",
    "jsep": "1.3.8",
    "keyv": "5.6.0",
    "lodash": "4.18.1",
    "papaparse": "5.4.1",
    "pdfkit": "^0.18.0",
    "query-string": "9.5.1",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "saml2-js": "4.0.4",
    "session-file-store": "1.5.0",
    "xml-js": "1.6.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
