    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@types/archiver": "6.0.2",
    "@types/async": "^3.2.25",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/fs-extra": "9.0.13",
    "@types/lodash": "4.14.178",
    "@types/multer": "1.4.7",
    "@types/node": "24.1.0",
    "@types/pdfkit": "^0.17.5",
    "@types/session-file-store": "1.2.2",
    "@types/supertest": "2.0.11",
    "@typescript/native-preview": "^7.0.0-dev.20250604.1",
    "@vitest/coverage-v8": "^4.1.11",
    "bump-package-versions": "1.0.7",
    "dotenv": "10.0.0",
    "dotenv-cli": "5.1.0",
    "glob": "7.2.0",
    "graphql": "17.0.2",
    "lefthook": "2.2.2",
    "rimraf": "^6.1.2",
    "sort-object-keys": "1.1.3",
    "source-map-support": "0.5.21",
    "supertest": "6.1.6",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.1",
    "tsconfig-paths": "3.12.0",
    "typescript": "6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "typescript": "6.0.3",
    "saml2-js": {
      "xmlbuilder2": "^4.0.3"
    }
  },
  "allowScripts": {
    "@biomejs/biome@2.5.15": true,
    "@swc/core@1.16.18": true,
    "core-js@3.36.0": true,
    "esbuild@0.27.2": true,
    "fsevents@2.3.3": true,
    "lefthook@2.2.2": true
  }
}
